FROM postgres:17.11
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY infra/postgres-tls.sh /usr/local/bin/stratino-postgres
COPY infra/postgres-app-role.sh /docker-entrypoint-initdb.d/10-stratino-app-role.sh
RUN chmod 755 /usr/local/bin/stratino-postgres /docker-entrypoint-initdb.d/10-stratino-app-role.sh
ENTRYPOINT ["/usr/local/bin/stratino-postgres"]
