[Unit]
Description=Consistent encrypted off-host backup of both businesses
Requires=docker.service
After=docker.service network-online.target
OnFailure=businesses-backup-alert.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/srv/businesses/current
ExecStart=/usr/bin/python3 /srv/businesses/current/hostctl.py backup
TimeoutStartSec=1800
