FROM python:3.12.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 STRATINO_ACADEMY_ROOT=/app/academy-content
WORKDIR /app
COPY apps/api/requirements.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt
COPY apps/api/ ./
# Canonical assessment data stays in the private API image, never the web root.
COPY docs/learning-design/ ./academy-content/
RUN useradd --create-home --uid 10001 stratino && mkdir -p /private-files /app/static-root && chown stratino:stratino /private-files /app/static-root
USER stratino
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "90"]
