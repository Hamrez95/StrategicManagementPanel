# TEMPLATE ONLY. Copy to .local-dev/production.env (ignored), never commit real values.
# Generate secrets with: node scripts/prepare-production.mjs --init
COMPOSE_PROJECT_NAME=stratino-production
RELEASE_ID=replace-with-git-sha
STRATINO_DOMAIN=stratino.ir
STRATINO_PUBLIC_URL=https://stratino.ir
DJANGO_ALLOWED_HOSTS=stratino.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://stratino.ir
DJANGO_SECRET_KEY=
STRATINO_OPERATOR_MFA_KEYS=
POSTGRES_DB=stratino
POSTGRES_USER=stratino
POSTGRES_PASSWORD=
# Used only by the optional self-hosted database initialization/backup, never API.
POSTGRES_ADMIN_USER=stratino_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Stratino <accounts@example.com>
GOOGLE_OAUTH_CLIENT_ID=
# Explicit product release choice, never inferred from the development runner.
VITE_ACADEMY_PREVIEW=false
