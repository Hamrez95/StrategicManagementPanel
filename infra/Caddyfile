{$STRATINO_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 24MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	@backend path /api /api/* /internal/django-admin /internal/django-admin/* /internal/management /internal/management/*
	handle @backend {
		reverse_proxy api:8000 {
			# Overwrite untrusted browser headers; API is not published on the host.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle_path /static/* {
		root * /srv/django-static
		file_server
	}
	@private path /media /media/* /private-files /private-files/* /.env /.env.* /.git /.git/*
	handle @private {
		respond 404
	}
	# Missing assets must return 404, never the SPA HTML.
	@assets path /assets/* /academy-content/* /prototype/* /src/* /brand/* /typography/* /sw.js /manifest*.webmanifest
	handle @assets {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
