  "learning_cards": [
    {
      "id": "C08-ST01-L02-CARD01",
      "type": "problem",
      "title": "مرکز کافی نیست",
      "text": "دو شعبه میانگین یکسان دارن، اما یکی پایدار و دیگری متکی به چند روز جهشیه."
    },
    {
      "id": "C08-ST01-L02-CARD02",
      "type": "definition",
      "title": "میانگین",
      "text": "مجموع مقدارها تقسیم بر تعداد؛ همهٔ مشاهدات اثر دارن و مقدار خیلی بزرگ میانگین رو بالا می‌بره."
    },
    {
      "id": "C08-ST01-L02-CARD03",
      "type": "explanation",
      "title": "میانه",
      "text": "مقدار وسط دادهٔ مرتب‌شده؛ برای تعداد زوج میانگین دو مقدار وسط. در دادهٔ کج گاهی مرکز معمولی‌تریه."
    },
    {
      "id": "C08-ST01-L02-CARD04",
      "type": "worked_example",
      "title": "مثال پنج سفارش",
      "text": "۲،۳،۳،۴،۱۸ روز: میانگین ۶، میانه ۳. مقدار ۱۸ میانگین رو بالا می‌کشه و نیاز به بررسی داره.",
      "example_kind": "fictional"
    },
    {
      "id": "C08-ST01-L02-CARD05",
      "type": "explanation",
      "title": "دامنه و IQR",
      "text": "دامنه بیشینه منهای کمینه؛ IQR=Q3−Q1 پراکندگی نیمهٔ میانی رو نشان می‌ده."
    },
    {
      "id": "C08-ST01-L02-CARD06",
      "type": "contrast",
      "title": "پراکندگی برای تصمیم",
      "text": "برای تعهد مشتری میانگین کافی نیست؛ صدک بالا، IQR و سهم دیرکرد رو هم بسنج."
    },
    {
      "id": "C08-ST01-L02-CARD07",
      "type": "key_terms",
      "title": "واژگان",
      "text": "میانگین، میانه، چارک، صدک، دامنه، IQR و توزیع کج."
    },
    {
      "id": "C08-ST01-L02-CARD08",
      "type": "authored_diagram",
      "title": "مقایسه",
      "text": "A: ۲،۳،۳،۴،۱۸؛ B: ۴،۵،۶،۷،۸. میانگین هر دو ۶ ولی میانه و پراکندگی متفاوته."
    },
    {
      "id": "C08-ST01-L02-CARD09",
      "type": "summary",
      "title": "جمع‌بندی",
      "text": "مرکز رو با شکل توزیع و پراکندگی بخون؛ شاخص مناسب به تصمیم وابسته‌ست."
    },
    {
      "id": "C08-ST01-L02-DEEP-REVIEW",
      "type": "explanation",
      "title": "چرا این روش جواب می‌ده و کجا محدود می‌شه؟",
      "text": "میانگین از همهٔ مقدارها اثر می‌گیره، درحالی‌که میانه جایگاه میانی رو نشان می‌ده؛ بنابراین چند سفارش بسیار دیررس می‌تونه میانگین رو بالا ببرد بی‌آنکه تجربهٔ معمول مشتری همان‌قدر تغییر کنه. پراکندگی نشان می‌ده اتکا به یک مقدار مرکزی چقدر خطرناکه. اگر هزینهٔ دم توزیع زیاد باشه، صدک‌ها و نرخ عبور از آستانه رو هم گزارش کن؛ انتخاب خلاصه‌ساز به شکل توزیع و هزینهٔ تصمیم بستگی داره."
    }
  ],
