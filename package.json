{
  "name": "stratino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:legacy && npm run build:web",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/verify-experience.mjs",
    "dev": "npm run build:domain && npm run prepare:prototype && npm run dev --workspace @stratino/web",
    "build:domain": "npm run build --workspace @stratino/domain",
    "build:legacy": "node scripts/build.mjs",
    "prepare:prototype": "node scripts/prepare-prototype.mjs",
    "build:web": "npm run build:domain && npm run prepare:prototype && npm run build --workspace @stratino/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:domain": "npm run build:domain && node --test packages/domain/tests/*.test.mjs",
    "test:web": "node scripts/verify-web.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "format:check": "prettier --check apps/web/src packages/domain/src packages/ui/src",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:knowledge": "node scripts/audit-management-knowledge.mjs",
    "test:knowledge": "node --test tests/management-knowledge.test.mjs",
    "build:knowledge-release": "node scripts/build-knowledge-release.mjs",
    "check:knowledge-release": "node scripts/build-knowledge-release.mjs --check && node scripts/build-knowledge-release.mjs --check --release stratino-first-slice-v2",
    "build:knowledge-release:v2": "node scripts/build-knowledge-release.mjs --release stratino-first-slice-v2",
    "test:knowledge-release": "node --test tests/management-knowledge-release.test.mjs",
    "test:contracts": "node --test tests/contracts.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "lint": "npm run check && eslint apps/web/src packages/domain/src packages/ui/src",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run check:contracts && npm run check:knowledge && npm test && npm run test:domain && npm run build",
    "test:gate": "node scripts/prove-test-gate.mjs",
    "test:browser:all": "node scripts/verify-browser-suite.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "js-yaml": "5.4.3",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "workspaces": [
    "apps/web",
    "packages/domain",
    "packages/ui"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
