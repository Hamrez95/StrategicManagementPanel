{
  "name": "stratino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:domain && npm run build:legacy && npm run build:web",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/verify-experience.mjs",
    "dev": "npm run prepare:prototype && npm run dev --workspace @stratino/web",
    "build:domain": "npm run build --workspace @stratino/domain",
    "build:legacy": "node scripts/build.mjs",
    "prepare:prototype": "node scripts/prepare-prototype.mjs",
    "build:web": "npm run prepare:prototype && npm run build --workspace @stratino/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:domain": "npm run build:domain && node --test packages/domain/tests/*.test.mjs",
    "test:web": "node scripts/verify-web.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "format:check": "prettier --check apps/web/src packages/*/src",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:contracts": "node --test tests/contracts.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "workspaces": [
    "apps/web",
    "packages/domain",
    "packages/ui"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
