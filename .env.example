# Local development only. Copy to an ignored .env and generate distinct secrets.
STRATINO_ENV=development
DJANGO_SECRET_KEY=
# Operator TOTP encryption key ring; first key encrypts, remaining keys decrypt.
# Generate a distinct Fernet key; never reuse DJANGO_SECRET_KEY or commit real keys.
STRATINO_OPERATOR_MFA_KEYS=
# Development only; each approved operator still opts out explicitly in account settings.
STRATINO_OPERATOR_MFA_OPTIONAL_IN_DEVELOPMENT=0
POSTGRES_PASSWORD=
API_PORT=8000
MAILPIT_PORT=8025
STRATINO_PUBLIC_URL=http://127.0.0.1:4173
STRATINO_ATTACHMENT_MAX_BYTES=20971520
STRATINO_WORKSPACE_FILE_QUOTA_BYTES=104857600
STRATINO_DOCUMENT_ATTACHMENT_LIMIT=20
STRATINO_ATTACHMENT_RESERVATION_MINUTES=30
# Google Identity Services web client ID (public identifier; no client secret).
GOOGLE_OAUTH_CLIENT_ID=
