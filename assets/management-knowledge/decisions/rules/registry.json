{
  "schema_version": "0.1.0",
  "condition_semantics": {
    "operators": [
      "eq"
    ],
    "all": "All conditions true; any false => not applicable; otherwise unknown.",
    "null": "Explicit null or absent input is unknown, never false, zero or healthy.",
    "priority": "Cash triage interrupts routine candidates; priority is editorial, not scientific severity."
  },
  "rules": [
    {
      "schema_version": "0.1.0",
      "id": "RULE-DISCOVERY",
      "epistemic_status": "product_heuristic_not_source_prescription",
      "conditions": {
        "all": [
          {
            "field": "stage",
            "op": "eq",
            "value": "idea"
          },
          {
            "field": "operating",
            "op": "eq",
            "value": false
          }
        ]
      },
      "evidence": [
        "customer_problem_hypothesis",
        "recent_customer_observation"
      ],
      "confidence": {
        "minimum_for_candidate": "low",
        "action_gate": "A candidate is an investigation prompt; obtain required evidence before a material commitment.",
        "model": "evidence/confidence-model.md"
      },
      "exceptions": [
        "A mandated technical feasibility study may precede customer testing; document why."
      ],
      "recommended_action": "ACT-DISCOVERY",
      "explanation": "A proposed model has not yet been supported by observed customer behavior.",
      "frameworks": [
        "FW-STARTUP-BUSINESS-MODEL-CANVAS"
      ],
      "sources": [
        "SRC-STARTUP-BLANK-2010"
      ],
      "priority": 20,
      "unknown_behavior": "defer_and_request_only_missing_condition_fields",
      "outputs": [
        "experiment"
      ],
      "human_review_required": true
    },
    {
      "schema_version": "0.1.0",
      "id": "RULE-RETENTION-BEFORE-SCALE",
      "epistemic_status": "product_heuristic_not_source_prescription",
      "conditions": {
        "all": [
          {
            "field": "stage",
            "op": "eq",
            "value": "early-traction"
          },
          {
            "field": "scale_acquisition_requested",
            "op": "eq",
            "value": true
          },
          {
            "field": "retention_evidence",
            "op": "eq",
            "value": "insufficient"
          }
        ]
      },
      "evidence": [
        "cohort_definition",
        "value_event",
        "observation_window",
        "cash_risk"
      ],
      "confidence": {
        "minimum_for_candidate": "low",
        "action_gate": "A candidate is an investigation prompt; obtain required evidence before a material commitment.",
        "model": "evidence/confidence-model.md"
      },
      "exceptions": [
        "Seasonal or one-time-value businesses need a different repeatability test.",
        "A deliberately capped experiment may be justified with a risk budget."
