{
  "schema_version": "0.1.0",
  "description": "Record contracts used by the offline validation. Fields not marked as strings accept documented domain variants; no claim of a unified production runtime schema.",
  "contracts": {
    "metrics": {
      "type": "object",
      "required": [
        "id",
        "name",
        "aliases",
        "domain",
        "business_types",
        "stages",
        "definition",
        "formula",
        "formula_variables",
        "unit",
        "direction",
        "interpretation",
        "why_it_matters",
        "leading_or_lagging",
        "dependencies",
        "required_inputs",
        "optional_inputs",
        "data_sources",
        "typical_owner",
        "update_frequency",
        "warnings",
        "limitations",
        "benchmarks",
        "benchmark_context",
        "related_metrics",
        "recommended_actions",
        "sources",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "formula_variables": {
          "type": "object",
          "minProperties": 1
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "business_types": {
          "type": "array",
          "minItems": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1
        },
        "benchmarks": {
          "type": "array"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "object",
          "required": [
            "quick",
            "learn",
            "deep_dive"
          ],
          "properties": {
            "quick": {
              "type": "string",
              "minLength": 1
            },
            "learn": {
              "type": "string",
              "minLength": 1
            },
            "deep_dive": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "frameworks": {
      "type": "object",
      "required": [
        "id",
        "name",
        "purpose",
        "use_when",
        "do_not_use_when",
        "inputs",
        "outputs",
        "steps",
        "interpretation",
        "common_mistakes",
        "limitations",
        "compatible_frameworks",
        "conflicting_frameworks",
        "business_types",
        "business_stages",
        "sources",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "use_when": {
          "type": "array",
          "minItems": 1
        },
        "do_not_use_when": {
          "type": "array",
          "minItems": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1
        },
        "business_types": {
          "type": "array",
          "minItems": 1
        },
        "business_stages": {
          "type": "array",
          "minItems": 1
        },
        "explanation": {
          "type": "object",
          "required": [
            "quick",
            "learn",
            "deep_dive"
          ],
          "properties": {
            "quick": {
              "type": "string",
              "minLength": 1
            },
            "learn": {
              "type": "string",
              "minLength": 1
            },
            "deep_dive": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "id",
        "title",
        "author",
        "year",
        "url",
        "type",
        "reliability",
        "notes",
        "last_reviewed",
        "access_depth",
        "supported_claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "access_depth": {
          "enum": [
            "full_text",
            "relevant_sections",
            "abstract_only",
            "search_excerpt",
            "metadata_only",
            "unavailable"
          ]
        },
        "last_reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supported_claims": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "id",
        "conditions",
        "evidence",
        "confidence",
        "exceptions",
        "recommended_action",
        "explanation",
        "frameworks",
        "sources",
        "unknown_behavior"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "required": [
        "id",
        "name",
        "context",
        "required_information",
        "steps",
        "outputs",
        "risks",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendations": {
      "type": "object",
      "required": [
        "id",
        "recommendation_id",
        "trigger",
        "business_context",
        "severity",
        "confidence",
        "reason",
        "expected_impact",
        "next_action",
        "alternative_actions",
        "required_information",
        "risks",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "anti_patterns": {
      "type": "object",
      "required": [
        "id",
        "symptoms",
        "risks",
        "how_to_detect",
        "recommended_response",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terms": {
      "type": "object",
      "required": [
        "id",
        "simple_explanation",
        "professional_definition",
        "formula",
        "example",
        "related_concepts",
        "common_confusion",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
