      ],
      "source_scope": "Conceptual basis only; exact cadence and agenda are product synthesis."
    },
    {
      "id": "CAD-BOARD",
      "name": "Board review",
      "purpose": "Present evidence, material risk and choices reserved for governance.",
      "participants": [
        "board or governance body",
        "authorized executives"
      ],
      "inputs": [
        "approved reporting scope",
        "material risks",
        "reserved matters"
      ],
      "agenda": [
        "Review outcomes and risks",
        "Challenge assumptions",
        "Record authorized decisions"
      ],
      "outputs": [
        "decision",
        "risk"
      ],
      "decisions": [
        "approve_within_authority",
        "defer_for_evidence"
      ],
      "metrics": [],
