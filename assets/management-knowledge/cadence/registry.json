{
  "schema_version": "0.1.0",
  "epistemic_status": "product_operating_templates_not_universal_prescriptions",
  "policy": "Frequency, participants and agendas are configurable hypotheses; choose the shortest useful review. Board legal obligations require jurisdiction-specific research.",
  "cadences": [
    {
      "id": "CAD-DAILY",
      "name": "Daily management",
      "purpose": "Surface deviations needing a response before the next operating cycle.",
      "participants": [
        "frontline owner",
        "shift/process lead"
      ],
      "inputs": [
        "exceptions",
        "dated commitments"
      ],
      "agenda": [
        "Review material deviations",
        "Assign containment or investigation",
        "Check yesterday’s action"
      ],
      "outputs": [
        "action",
        "risk"
      ],
      "decisions": [
        "respond",
        "escalate",
        "no_action"
      ],
      "metrics": [
        "MET-THROUGHPUT",
        "MET-DEFECT-RATE"
      ],
      "anti_patterns": [
        "Reading every KPI aloud",
        "Blaming the reporter",
        "Founder forced into a daily committee"
      ],
      "sources": [
        "SRC-CORE-LEI-HOSHIN",
        "SRC-CORE-CIPD-EVIDENCE"
      ],
      "source_scope": "Conceptual basis only; exact cadence and agenda are product synthesis."
    },
    {
      "id": "CAD-WEEKLY",
      "name": "Weekly business review",
      "purpose": "Resolve near-term priorities and cross-team blockers.",
      "participants": [
        "business owner",
        "relevant function owners"
      ],
      "inputs": [
        "weekly comparable outcomes",
        "open commitments"
      ],
      "agenda": [
        "Inspect exceptions",
        "Test cause hypotheses",
        "Agree next actions and owners"
      ],
      "outputs": [
        "action",
        "decision"
      ],
      "decisions": [
        "continue",
        "change",
        "request_evidence"
      ],
      "metrics": [],
      "anti_patterns": [
        "Turning the review into a status recital",
        "Comparing incomplete cohorts"
      ],
      "sources": [
        "SRC-CORE-LEI-HOSHIN",
        "SRC-CORE-CIPD-EVIDENCE"
      ],
      "source_scope": "Conceptual basis only; exact cadence and agenda are product synthesis."
    },
    {
      "id": "CAD-MONTHLY",
      "name": "Monthly business review",
      "purpose": "Reconcile financial and operating outcomes and adjust resource assumptions.",
      "participants": [
        "finance owner",
        "business leader",
        "function owners"
      ],
      "inputs": [
        "closed financial period",
        "cash outlook",
        "initiative evidence"
      ],
      "agenda": [
        "Reconcile actual versus forecast",
        "Inspect drivers and trade-offs",
        "Approve revised assumptions"
      ],
      "outputs": [
        "decision",
        "risk"
      ],
      "decisions": [
        "reforecast",
        "reallocate",
        "no_action"
      ],
      "metrics": [
        "MET-GROSS-MARGIN",
        "MET-OPERATING-CASH-FLOW"
      ],
      "anti_patterns": [
        "Treating budget variance as proven cause",
        "Confusing profit with available cash"
      ],
      "sources": [
        "SRC-CORE-LEI-HOSHIN",
        "SRC-CORE-CIPD-EVIDENCE"
      ],
      "source_scope": "Conceptual basis only; exact cadence and agenda are product synthesis."
    },
    {
      "id": "CAD-QUARTERLY",
      "name": "Quarterly strategy review",
      "purpose": "Review strategic assumptions and portfolio choices.",
      "participants": [
        "leadership",
        "initiative owners"
      ],
      "inputs": [
        "strategy hypotheses",
        "customer and market changes",
        "resource constraints"
      ],
      "agenda": [
        "Review evidence for strategic assumptions",
        "Stop or reprioritize initiatives",
        "Record trade-offs"
      ],
      "outputs": [
        "decision",
