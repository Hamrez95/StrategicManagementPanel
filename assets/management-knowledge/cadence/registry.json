      "participants": [
        "forecast owner",
        "finance",
        "relevant driver owners"
      ],
      "inputs": [
        "current actuals",
        "changed assumptions"
      ],
      "agenda": [
        "Reconcile actuals",
        "Update drivers and ranges",
        "Record forecast revision and implications"
      ],
      "outputs": [
        "insight",
        "decision"
      ],
      "decisions": [
        "revise",
        "request_data"
      ],
      "metrics": [],
