      ],
      "source_scope": "Conceptual basis only; exact cadence and agenda are product synthesis."
    },
    {
      "id": "CAD-ANNUAL",
      "name": "Annual planning",
      "purpose": "Choose direction and capacity envelope with explicit scenarios.",
      "participants": [
        "leadership",
        "finance",
        "function owners"
      ],
      "inputs": [
        "outcomes",
        "capability and capacity evidence",
        "material uncertainties"
      ],
      "agenda": [
        "Review lessons",
        "Choose strategic priorities",
        "Align resources and review triggers"
      ],
      "outputs": [
        "decision",
